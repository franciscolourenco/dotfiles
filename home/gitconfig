[core]
	excludesfile = ~/.gitignore
	ignorecase = false
	# Format interactive Git output; captured diffs retain Git's standard format.
	pager = delta
[color]
	diff = auto
	status = auto
	branch = auto
	interactive = auto
	ui = true
	pager = true
[interactive]
	diffFilter = delta --color-only
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[diff]
 	renames = copy # makes the diff much shorter when moving or copying files
[alias]
  aliases = !git config --get-regexp 'alias.*' | colrm 1 6 | sed 's/[ ]/ = /' | sort
	lg = "!git --no-pager log --reverse --color=always --pretty=format:'%Cgreen%cd %Cred%h%Creset %s%C(yellow)%d%Creset by %C(magenta)%ae%Creset' --abbrev-commit --max-count=200 --date=format-local:'%a, %d %b %H:%M' | sed -E 's/pull request/PR/' | sed -E 's/Merge PR (#[0-9]+) from ([^[:space:]]+)/Merge PR \\x1b[1;34m\\1\\x1b[0m from \\x1b[1;34m\\2\\x1b[0m/'"
	lgmerge = "!git --no-pager log --merges --reverse --color=always --pretty=format:'%Cgreen%cd %Cred%h%Creset %s%C(yellow)%d%Creset by %C(magenta)%ae%Creset' --abbrev-commit --max-count=200 --date=format-local:'%a, %d %b %H:%M' | sed -E 's/pull request/PR/' | sed -E 's/Merge PR (#[0-9]+) from ([^[:space:]]+)/Merge PR \\x1b[1;34m\\1\\x1b[0m from \\x1b[1;34m\\2\\x1b[0m/'"
	lgmine = "!git --no-pager log --reverse --color=always --pretty=format:'%Cgreen%cd %Cred%h%Creset %s%C(yellow)%d%Creset by %C(magenta)%ae%Creset' --abbrev-commit --date=format-local:'%Y %b %d %H:%M' --author=\"Francisco\" | sed -E 's/pull request/PR/' | sed -E 's/Merge PR (#[0-9]+) from ([^[:space:]]+)/Merge PR \\x1b[1;34m\\1\\x1b[0m from \\x1b[1;34m\\2\\x1b[0m/'"
	graph = "!git log --color=always --graph --pretty=format:'%Cgreen%cd %Cred%h%Creset %s%C(yellow)%d%Creset by %C(magenta)%ae%Creset' --abbrev-commit --date=format-local:'%a, %d %b %H:%M' | sed -E 's/pull request/PR/' | sed -E 's/Merge PR (#[0-9]+) from ([^[:space:]]+)/Merge PR \\x1b[1;34m\\1\\x1b[0m from \\x1b[1;34m\\2\\x1b[0m/' | ${PAGER:-less -R}"
	find = log --diff-filter=A
	report = !git log --author=\"`git config user.name`\" --format='%Cgreen%ci%Creset %s%Creset' --no-merges --reverse
	prune = fetch --prune
	stash-all = stash save --include-untracked
	cleanb = !git branch --merged | grep -v '\\*\\|master\\|main' | xargs -n 1 git branch -d
	unstage = reset HEAD --
	uncommit = reset HEAD~1 --soft
	di = !git branch --no-color --sort=-committerdate | fzf -m --header='Delete branches' | xargs -I {} git branch -D '{}'
	ci = "!git checkout $(git branch --no-color --sort=-committerdate | fzf --header 'Checkout branch' | xargs)"
[include]
	path = ~/.gitlocal
[push]
	default = current
	autoSetupRemote = true
	# followTags = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[branch]
	autosetuprebase = always
	sort = committerdate
[pull]
	rebase = true
[status]
	showUntrackedFiles = all
[commit]
	gpgsign = true
	cleanup = strip
[gpg]
  format = ssh
[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
[tag]
	forceSignAnnotated = true
[rerere]
	enabled = true
[credential]
	helper = osxkeychain
[init]
	defaultBranch = main
[delta]
	navigate = true  # use n and N to move between diff sections
	line-numbers = true
	true-color = always
	features = decorations
	side-by-side = false
	theme = "base16"
[difftool]
	# Run the difftool immediately, don't ask 'are you sure' each time.
	prompt = false
[difftool "difftastic"]
	# Opt in with: git difftool -t difftastic
	# See `man git-difftool` for a description of MERGED, LOCAL and REMOTE.
	cmd = difft "$MERGED" "$LOCAL" "abcdef1" "100644" "$REMOTE" "abcdef2" "100644"
[pager]
	# Difftastic renders its own output; do not pass it through Delta.
	difftool = false
[log]
	date = local
[merge "mergiraf"]
	name = mergiraf
	driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L
[rebase]
	updateRefs = true
[merge]
	# Mergiraf needs diff3 to reconstruct all three versions; zdiff3 can break parsing.
	conflictstyle = diff3
